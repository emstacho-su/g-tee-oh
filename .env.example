# g-tee-oh local configuration (A1 section 6: twelve-factor, every variable listed here with a comment).
# Copy this file to .env (gitignored) and replace every placeholder; "just dev-up" and dbmate read .env
# from the repo root. A placeholder is the word change-me, a hyphen and a name, and the same placeholder on
# two lines must receive the same value, because DATABASE_URL embeds POSTGRES_PASSWORD; the S02 generator
# and the e2e workflow replace them placeholder by placeholder with random hex.
#
# Role logins (O-28) connect as postgres://<role>_login:<password>@localhost:5432/gto?sslmode=disable, and
# inside Compose the host is postgres instead of localhost. The S3 (Simple Storage Service) host inside
# Compose is seaweedfs instead of localhost.

# Postgres superuser password of the Compose postgres service; dev only, the services use the role logins below (architecture decision record (ADR) 0005)
POSTGRES_PASSWORD=change-me-postgres
# Superuser URL (Uniform Resource Locator) used by dbmate, the db tests and codegen (ADR 0005); its password is POSTGRES_PASSWORD
DATABASE_URL=postgres://postgres:change-me-postgres@localhost:5432/gto?sslmode=disable
# Password of app_login, member of the NOLOGIN group role app that the api service uses (O-28)
APP_DB_PASSWORD=change-me-app
# Password of builder_login, member of builder, the role library-builder writes the library tables under (O-28)
BUILDER_DB_PASSWORD=change-me-builder
# Password of capture_login, member of capture, the role the private capture repo inserts reference rows under (O-28)
CAPTURE_DB_PASSWORD=change-me-capture
# Password of query_login, member of the read-only query role solver-query reads under (O-28).
# Set, it enables solver-query's database; the service takes it on its own, never inside a URL,
# so it needs no percent-encoding (O-146)
QUERY_DB_PASSWORD=change-me-query
# The other parts of solver-query's query-role connection, optional (O-146): host, port, database,
# login and sslmode. Empty, they are 127.0.0.1 (where the dev profile publishes Postgres), 5432,
# gto, query_login and prefer, which fit a run on the host (cargo run -p solver-query with
# QUERY_DB_PASSWORD exported); Compose sets host postgres and sslmode disable itself
QUERY_DB_HOST=
QUERY_DB_PORT=
QUERY_DB_NAME=
QUERY_DB_USER=
QUERY_DB_SSLMODE=
# S3 gateway of the SeaweedFS service (ADR 0019), reached from the host; path-style addressing
S3_ENDPOINT=http://localhost:8333
# Admin identity of the S3 gateway: every action on every bucket; only bucket-init and the smoke script use it
S3_ADMIN_ACCESS_KEY=change-me-s3-admin-key
S3_ADMIN_SECRET_KEY=change-me-s3-admin-secret
# Identity limited to the library bucket (the solutions library): Read, Write, List, Tagging on library only (02 section 6.4)
S3_LIBRARY_ACCESS_KEY=change-me-s3-library-key
S3_LIBRARY_SECRET_KEY=change-me-s3-library-secret
# Identity limited to the reference-private bucket (private reference data, O-28): Read, Write, List, Tagging on it only
S3_REFERENCE_ACCESS_KEY=change-me-s3-reference-key
S3_REFERENCE_SECRET_KEY=change-me-s3-reference-secret
# Host directory the dev profile bind-mounts read-only into solver-query at /fixtures/library (O-62); empty falls back to validation/fixtures/library, the placeholder S19 fills. "just fixture-synthetic" packs a synthetic library into target/fixtures/library to point this at (O-149)
FIXTURE_LIBRARY_PATH=
# solver-query chunk cache size in bytes; 2 GiB per the 02 section 6.2 memory budget
QUERY_CACHE_BYTES=2147483648
# Salt of the private-data guard's hashed denylist; empty locally because the guard reads .guard-private/salt, set as a continuous integration (CI) secret (O-58)
GUARD_SALT=
# Host name Caddy serves with a certificate from its internal certificate authority (A9 section 3)
CADDY_SITE=localhost
