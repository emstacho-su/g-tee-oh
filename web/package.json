{
  "name": "@g-tee-oh/web",
  "version": "0.0.0",
  "private": true,
  "description": "Vite single-page app: the trainer front end (S06, S24)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "build:harness": "vite build --mode harness",
    "preview:harness": "vite preview --mode harness --outDir dist-harness --port 4173 --strictPort",
    "e2e": "playwright test --project=stack",
    "e2e:mock": "playwright test --project=mock",
    "bench": "playwright test --project=bench",
    "shots": "playwright test --project=shots"
  },
  "dependencies": {
    "@g-tee-oh/contracts": "workspace:*",
    "@g-tee-oh/learning": "workspace:*",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.45",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
