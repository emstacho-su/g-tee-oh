{
  "name": "g-tee-oh",
  "version": "0.0.0",
  "private": true,
  "description": "Personal no-limit hold'em trainer and solver: pnpm workspace root (R0.1)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint && pnpm run lint:root",
    "lint:root": "eslint guard scripts eslint.config.js",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && pnpm run test:scripts",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
