{
  "version": 1,
  "note": "The spots a drill reaches (S47, R3.37, O-485): the api's candidate rule (services/api/src/sessions/candidates.ts) restated as cases. Configurations match by format, table size, stake label, depth_cbb in depths_bb times 100 and ante 0; pairs are every hero against every villain, every other seat when the villain list is empty, written out of position first, without repeats. services/api/test/sessions-candidate-rule-cases.test.ts runs the cases against the api's functions and web/test/drills/reach-model.test.ts against the web's reach model, so a change on one side fails the other.",
  "configs": [
    { "config_id": "cfg_6_online_100", "format": "online", "table_size": 6, "stake_label": "online", "depth_cbb": 10000, "ante_cbb": 0 },
    { "config_id": "cfg_6_online_150", "format": "online", "table_size": 6, "stake_label": "online", "depth_cbb": 15000, "ante_cbb": 0 },
    { "config_id": "cfg_6_online_200", "format": "online", "table_size": 6, "stake_label": "online", "depth_cbb": 20000, "ante_cbb": 0 },
    { "config_id": "cfg_6_online_100_ante10", "format": "online", "table_size": 6, "stake_label": "online", "depth_cbb": 10000, "ante_cbb": 10 },
    { "config_id": "cfg_9_live_13_100", "format": "live", "table_size": 9, "stake_label": "1/3", "depth_cbb": 10000, "ante_cbb": 0 },
    { "config_id": "cfg_9_live_25_100", "format": "live", "table_size": 9, "stake_label": "2/5", "depth_cbb": 10000, "ante_cbb": 0 }
  ],
  "cases": [
    {
      "name": "button opens against any seat at 100 bb",
      "filter": { "game_config": { "format": "online", "table_size": 6, "depths_bb": [100] }, "stake": "online", "hero_positions": ["BTN"], "villain_positions": [] },
      "expected": { "config_ids": ["cfg_6_online_100"], "pairs": ["BB-BTN", "CO-BTN", "HJ-BTN", "SB-BTN", "UTG-BTN"] }
    },
    {
      "name": "big blind facing the button is one pair",
      "filter": { "game_config": { "format": "online", "table_size": 6, "depths_bb": [100] }, "stake": "online", "hero_positions": ["BB"], "villain_positions": ["BTN"] },
      "expected": { "config_ids": ["cfg_6_online_100"], "pairs": ["BB-BTN"] }
    },
    {
      "name": "two heroes, one villain, two depths skip the depth the drill does not name",
      "filter": { "game_config": { "format": "online", "table_size": 6, "depths_bb": [100, 200] }, "stake": "online", "hero_positions": ["SB", "BB"], "villain_positions": ["BTN"] },
      "expected": { "config_ids": ["cfg_6_online_100", "cfg_6_online_200"], "pairs": ["BB-BTN", "SB-BTN"] }
    },
    {
      "name": "eight live opening seats reach every pair of a 9-handed table",
      "filter": { "game_config": { "format": "live", "table_size": 9, "depths_bb": [100] }, "stake": "1/3", "hero_positions": ["UTG", "UTG1", "UTG2", "LJ", "HJ", "CO", "BTN", "SB"], "villain_positions": [] },
      "expected": {
        "config_ids": ["cfg_9_live_13_100"],
        "pairs": ["BB-BTN", "BB-CO", "BB-HJ", "BB-LJ", "BB-UTG", "BB-UTG1", "BB-UTG2", "CO-BTN", "HJ-BTN", "HJ-CO", "LJ-BTN", "LJ-CO", "LJ-HJ", "SB-BB", "SB-BTN", "SB-CO", "SB-HJ", "SB-LJ", "SB-UTG", "SB-UTG1", "SB-UTG2", "UTG-BTN", "UTG-CO", "UTG-HJ", "UTG-LJ", "UTG-UTG1", "UTG-UTG2", "UTG1-BTN", "UTG1-CO", "UTG1-HJ", "UTG1-LJ", "UTG1-UTG2", "UTG2-BTN", "UTG2-CO", "UTG2-HJ", "UTG2-LJ"]
      }
    },
    {
      "name": "a villain who is also the hero is skipped",
      "filter": { "game_config": { "format": "online", "table_size": 6, "depths_bb": [100] }, "stake": "online", "hero_positions": ["BTN"], "villain_positions": ["BTN", "BB"] },
      "expected": { "config_ids": ["cfg_6_online_100"], "pairs": ["BB-BTN"] }
    },
    {
      "name": "five opening seats reach every pair but one of a 6-max table, each once",
      "filter": { "game_config": { "format": "online", "table_size": 6, "depths_bb": [100] }, "stake": "online", "hero_positions": ["UTG", "HJ", "CO", "BTN", "SB"], "villain_positions": [] },
      "expected": { "config_ids": ["cfg_6_online_100"], "pairs": ["BB-BTN", "BB-CO", "BB-HJ", "BB-UTG", "CO-BTN", "HJ-BTN", "HJ-CO", "SB-BB", "SB-BTN", "SB-CO", "SB-HJ", "SB-UTG", "UTG-BTN", "UTG-CO", "UTG-HJ"] }
    },
    {
      "name": "a stake the catalog lacks at that size reaches no configuration",
      "filter": { "game_config": { "format": "live", "table_size": 9, "depths_bb": [100] }, "stake": "5/10", "hero_positions": ["BTN"], "villain_positions": [] },
      "expected": { "config_ids": [], "pairs": ["BB-BTN", "CO-BTN", "HJ-BTN", "LJ-BTN", "SB-BTN", "UTG-BTN", "UTG1-BTN", "UTG2-BTN"] }
    },
    {
      "name": "a depth the catalog lacks reaches no configuration",
      "filter": { "game_config": { "format": "online", "table_size": 6, "depths_bb": [137] }, "stake": "online", "hero_positions": ["BTN"], "villain_positions": [] },
      "expected": { "config_ids": [], "pairs": ["BB-BTN", "CO-BTN", "HJ-BTN", "SB-BTN", "UTG-BTN"] }
    }
  ]
}
